dataset:
  files: '/glade/work/kavulich/MPAS/tutorial/120km_global/rundir/diag.2025-05-08_00.00.00.nc'
  gridfile: '/glade/work/kavulich/MPAS/tutorial/120km_global/rundir/x1.40962.static.nc'
  #gridfile: '/glade/work/kavulich/MPAS/tutorial/120km_global/rundir/x1.40962.init.nc'
  vars:
    t2m:
      source: native
      plot:
        lakes:
          scale: '10m'
          enable: False
          color: 'lightblue'
    precipw:
      source: native
    rainnc:
      source: native
    refl10cm_1km:
      source: native
      plot:
        colormap: radar_refl
    # One variable can be plotted more than one way. Anything directly under the variable
    # applies to all of its blocks; anything inside a block applies to that kind of figure
    # only. A 3-D field is needed for a cross-section, so this one is left commented out --
    # the diag file above has none. Put {ptype} in plot:filename to keep the two kinds of
    # figure from landing on the same name.
    #theta:
    #  source: native
    #  plot:
    #    colormap: RdBu_r
    #  model_level:
    #    lev:
    #      - 0
    #      - 30
    #    plot:
    #      vmin: 260
    #      vmax: 320
    #      transects:          # show where the section below is taken
    #        enable: True
    #  cross_section:
    #    names: [cascades]    # omit to section along every transect defined below
    #    ymax: 12000
    #    plot:
    #      vmin: 280
    #      vmax: 340

plot:
  # {var} = Variable name
  # {lev} = Variable level
  # {varln} = Variable "long name" (not recommended for filenames since these often contain spaces)
  # {units} = Variable units
  # {filename} = Name of file being read for plotted data
  # {fnme} = Name of file (minus extension) being read for plotted data
  # {date} = The date of plotted data, in %Y-%m-%d format
  # {time} = The time of plotted data, in %H:%M:%S format

  filename: 'tutorial_data/{var}_lev{lev}_{date}_{time}.png'
  title:
    text: 'Plot of {varln}, level {lev} for MPAS forecast, {date} {time}'
    fontsize: 8
  edges:
    #    color: black
    color: face
    # set width to 0 to have no borders
    width: 0.1
  boundaries:
    detail: 0
    scale: '10m'
    color: 'k'
    linewidth: 0.5
  coastlines:
    scale: '10m'
    color: 'k'
    linewidth: 0.2
  colorbar:
    orientation: vertical
    label: 'Units: {units}'
    fontsize: 8
  # Colormap for output from Matplotlib. Reference: https://matplotlib.org/stable/gallery/color/colormap_reference.html
  colormap: "viridis"
  dpi: 300
  figwidth: 5
  projection:
    projection: PlateCarree

# ---------------------------------------------------------------------------------------
# Vertical cross-sections
#
# Transects are usually defined here, at the top level, so that any variable with a
# "cross_section:" block can name them. Each is a list of [latitude, longitude] waypoints
# joined by great-circle arcs, so two waypoints give a straight section and more let it bend
# to follow a feature. A variable can add transects of its own in its own block.
#
# Note that a height axis in meters needs a "gridfile" containing "zgrid" (usually init.nc or
# static.nc); without one the vertical axis falls back to the model level index.

cross_section:
  transects:
    # A straight section, west to east across the mountains
    cascades:
      - [45.0, -124.5]
      - [45.0, -119.0]
    # Extra waypoints let a section bend to follow a feature
    dogleg:
      - [47.5, -124.0]
      - [46.0, -121.5]
      - [44.0, -121.0]
  steps: 200
